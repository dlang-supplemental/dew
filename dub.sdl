name "dew"
description "Modern retained-mode GUI for D: typed DSL, CTFE markup, flex layout, Vello 2D + wgpu 3D, tgc-friendly"
authors "amdphreak"
copyright "Copyright © 2026, dlang-supplemental contributors"
license "BSL-1.0"
version "0.1.5"
# Keep in sync with VERSION / DEW_VERSION / git tag vX.Y.Z.

targetType "library"
targetName "dew"

dependency "tgc" version="~>0.1.1"

configuration "library" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "DewHeadless"
}

configuration "unittest" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "Tgc_default" "DewHeadless"
}

configuration "headless" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "DewHeadless"
}

# GPU hosts need a sibling checkout of vello-d (CI does this; local hive already has it).
# Flip to registry `~>0.1.4` after that version is published — path pins are validated
# by DUB for every configuration, so CI must keep the sibling present.
configuration "gpu" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	dependency "vello-d" path="../vello-d"
	dependency "bindbc-wgpu" version="~>0.27.0"
}
