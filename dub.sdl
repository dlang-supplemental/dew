name "dew"
description "Modern retained-mode GUI for D: typed DSL, CTFE markup, flex layout, Vello 2D + wgpu 3D, tgc-friendly"
authors "amdphreak"
copyright "Copyright © 2026, dlang-supplemental contributors"
license "BSL-1.0"
version "0.1.7"
# Keep in sync with VERSION / DEW_VERSION / git tag vX.Y.Z.

targetType "library"
targetName "dew"

dependency "tgc" version="~>0.1.1"

configuration "library" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "DewHeadless"
}

configuration "unittest" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "Tgc_default" "DewHeadless"
}

configuration "headless" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "DewHeadless"
}

# GPU hosts require vello-d 0.1.4 or newer. Release vello-d 0.1.4 before this
# Dew manifest so consumers can resolve every configuration from the registry.
configuration "gpu" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	dependency "vello-d" version="~>0.1.4"
	dependency "bindbc-wgpu" version="~>0.27.0"
	# Re-export bridge link flags so GPU hosts (executables) pick up vello_bridge.
	platform "windows" {
		lflags "/LIBPATH:$PACKAGE_DIR/../vello-d/vello_bridge/target/release"
		libs "vello_bridge" "advapi32" "userenv" "ws2_32" "bcrypt" "ntdll" "kernel32" "shell32" "ole32"
	}
	platform "posix" {
		lflags "-L$PACKAGE_DIR/../vello-d/vello_bridge/target/release"
		libs "vello_bridge" "pthread" "dl" "m"
	}
}
