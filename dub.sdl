name "dew"
description "Modern retained-mode GUI for D: typed DSL, CTFE markup, flex layout, Vello 2D + wgpu 3D, tgc-friendly"
authors "amdphreak"
copyright "Copyright © 2026, dlang-supplemental contributors"
license "BSL-1.0"
version "0.1.4"
# Keep in sync with VERSION / DEW_VERSION / git tag vX.Y.Z.

targetType "library"
targetName "dew"

dependency "tgc" version="~>0.1.1"

configuration "library" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "DewHeadless"
}

configuration "unittest" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "Tgc_default" "DewHeadless"
}

configuration "headless" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "DewHeadless"
}

# GPU hosts. Prefer registry once vello-d 0.1.4 is published (`~>0.1.4`).
# Do not path-pin in this recipe or dub.selections.json — DUB loads path
# selections for every configuration and breaks headless CI.
configuration "gpu" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	dependency "vello-d" repository="git+https://github.com/dlang-supplemental/vello-d.git" version="cursor/draw-text-0.1.4"
	dependency "bindbc-wgpu" version="~>0.27.0"
}
